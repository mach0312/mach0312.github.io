---
import { NAV, SITE_TITLE, SITE_TITLE_EN } from '../consts';

const strip = (p: string) => p.replace(/\/$/, '') || '/';
const path = strip(Astro.url.pathname);
const isActive = (href: string) => {
	const h = strip(href);
	return h === '/' ? path === '/' : path === h || path.startsWith(`${h}/`);
};
---

<header class="site-header">
	<div class="container header-inner">
		<a class="wordmark" href="/">
			<span class="dot" aria-hidden="true"></span>
			<span class="name">{SITE_TITLE}</span>
			<span class="name-en">{SITE_TITLE_EN.toLowerCase()}</span>
		</a>
		<nav aria-label="주 메뉴">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<button class="theme-toggle" type="button" aria-label="밝은 테마와 어두운 테마 전환">
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
						<circle cx="12" cy="12" r="4.2"></circle>
						<path
							d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
						></path>
					</g>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	button?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			// 저장소를 못 쓰는 환경이면 이번 페이지에만 적용한다.
		}
	});
</script>
