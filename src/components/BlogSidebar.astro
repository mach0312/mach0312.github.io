---
import { TOPICS } from '../consts';
import { type Post, tagSlug, topicSlug } from '../utils/posts';

interface Props {
	// 개수는 항상 전체 글 기준으로 센다.
	posts: Post[];
	activeTopic?: string;
	activeTag?: string;
}

const { posts, activeTopic, activeTag } = Astro.props;

const topicCounts = TOPICS.map((t) => [t, posts.filter((p) => p.data.topic === t).length] as const).filter(
	([, n]) => n > 0,
);

const tagMap = new Map<string, number>();
for (const tag of posts.flatMap((p) => p.data.tags)) tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
const tagCounts = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const isAll = !activeTopic && !activeTag;
---

<aside class="blog-sidebar" aria-label="글 분류">
	<div class="facet">
		<h2 class="facet-label">Topic</h2>
		<ul class="facet-list">
			<li>
				<a href="/blog/" aria-current={isAll ? 'page' : undefined}>
					<span>All</span><span class="count">{posts.length}</span>
				</a>
			</li>
			{
				topicCounts.map(([topic, n]) => (
					<li>
						<a href={`/blog/topic/${topicSlug(topic)}/`} aria-current={activeTopic === topic ? 'page' : undefined}>
							<span>{topic}</span>
							<span class="count">{n}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
	{
		tagCounts.length > 0 && (
			<div class="facet">
				<h2 class="facet-label">Tag</h2>
				<ul class="tag-cloud">
					{tagCounts.map(([tag, n]) => (
						<li>
							<a
								href={`/blog/tag/${tagSlug(tag)}/`}
								aria-current={activeTag === tag ? 'page' : undefined}
								title={`${n}개 글`}
							>
								#{tag}
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}
</aside>
