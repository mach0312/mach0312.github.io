---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post, i) => {
		const seriesName = post.data.series;
		const series = seriesName
			? posts
					.filter((p) => p.data.series === seriesName)
					.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
			: [];
		return {
			params: { slug: post.id },
			props: { post, newer: posts[i - 1], older: posts[i + 1], series },
		};
	});
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
	series: Post[];
}

const { post, newer, older, series } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} newer={newer} older={older} series={series}>
	<Content />
</BlogPost>
