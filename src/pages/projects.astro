---
import { PROJECT_GROUPS } from '../data/profile';
import Base from '../layouts/Base.astro';
---

<Base title="Projects" description="반영, 공개, 운용까지 마친 작업만 모았습니다.">
	<header class="page-head">
		<h1>Projects</h1>
		<p>반영, 공개, 운용까지 마친 작업만 모았습니다. 회사 저장소는 비공개라 링크 대신 설명만 적었습니다.</p>
	</header>
	{
		PROJECT_GROUPS.map((group) => (
			<section class="project-group">
				<h2 class="section-label">{group.title}</h2>
				<ul class="project-list">
					{group.items.map((p) => (
						<li class="project">
							<h3 class="project-name">
								{p.links[0] ? <a href={p.links[0].href}>{p.name}</a> : <span>{p.name}</span>}
							</h3>
							<p class="project-status">{p.status}</p>
							<p>{p.desc}</p>
							<div class="project-meta">
								<ul class="stack" aria-label="사용 기술">
									{p.stack.map((s) => (
										<li>{s}</li>
									))}
								</ul>
								<span class="project-links">
									{p.links.map((l) => (
										<a href={l.href}>{l.label} ↗</a>
									))}
									{p.links.length === 0 && p.privateNote && (
										<span class="project-private">{p.privateNote}</span>
									)}
								</span>
							</div>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Base>
