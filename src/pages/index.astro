---
import PostRow from '../components/PostRow.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SITE_TITLE_EN } from '../consts';
import { FACTS, PROFILE, PUBLICATIONS, SELF_NAMES } from '../data/profile';
import Base from '../layouts/Base.astro';
import { getPublishedPosts } from '../utils/posts';

const recent = (await getPublishedPosts()).slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<div class="intro-text">
			<p class="eyebrow">{PROFILE.eyebrow}</p>
			<h1>
				{SITE_TITLE}
				<span class="en">{SITE_TITLE_EN}</span>
			</h1>
			<p class="lead">{PROFILE.lead}</p>
			<p>{PROFILE.intro}</p>
		</div>
		<dl class="facts">
			{
				FACTS.map((f) => (
					<div>
						<dt>{f.label}</dt>
						<dd>{f.value}</dd>
					</div>
				))
			}
			<div>
				<dt>연락</dt>
				<dd>
					<a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
					<span class="sep" aria-hidden="true">·</span>
					<a href={AUTHOR.github}>GitHub</a>
					<span class="sep" aria-hidden="true">·</span>
					<a href={AUTHOR.orcid}>ORCID</a>
				</dd>
			</div>
		</dl>
	</section>

	<section class="home-section" aria-labelledby="pubs">
		<h2 class="section-label" id="pubs">Publications</h2>
		<ol class="pub-list">
			{
				PUBLICATIONS.map((p) => (
					<li class="pub">
						<span class="pub-year">{p.year}</span>
						<div>
							<p class="pub-title">{p.title}</p>
							{p.titleEn && <p class="pub-title-en">{p.titleEn}</p>}
							<p class="pub-byline">
								{p.authors.map((a, i) => (
									<>
										{i > 0 && ', '}
										{SELF_NAMES.includes(a) ? <strong>{a}</strong> : a}
									</>
								))}
							</p>
							<p class="pub-venue">
								<span class="pub-kind">{p.kind}</span>
								<span>{p.venue}</span>
								{p.status && <span class="pub-status">{p.status}</span>}
								{p.links.map((l) => (
									<a class="pub-link" href={l.href}>
										{l.label}
									</a>
								))}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="home-section" aria-labelledby="recent">
		<h2 class="section-label" id="recent">Recent posts</h2>
		<div>
			<ol class="post-list">
				{recent.map((post) => <PostRow post={post} withYear />)}
			</ol>
			<a class="more-link" href="/blog/">전체 글 보기 →</a>
		</div>
	</section>

	<section class="home-section" aria-labelledby="work">
		<h2 class="section-label" id="work">Projects</h2>
		<div>
			<p class="section-note">{PROFILE.projectsNote}</p>
			<a class="more-link" href="/projects/">프로젝트 보기 →</a>
		</div>
	</section>
</Base>
